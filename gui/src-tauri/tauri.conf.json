{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "periwire",
  "version": "0.1.0",
  "identifier": "io.github.imyourboyroy.periwire",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "periwire",
        "width": 1140,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Share USB devices over the network",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
