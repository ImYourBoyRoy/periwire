# Copy to tools/lab.env (git-ignored) and fill in. Only used by the developer scripts in tools/.
REMOTE_HOST=server.example.lan      # machine that imports devices (runs the importer)
REMOTE_USER=youruser
# REMOTE_DIR=/home/youruser/periwire
GUEST_HOST=192.0.2.10               # optional: a VM behind REMOTE_HOST (reached via ssh -J)
# Windows test VM (only for tools/winrun.py and win-e2e.sh):
# WIN_HOST=192.0.2.20               # the VM's address as REMOTE_HOST sees it (not needed when you set WINRUN_HOST for a direct connection)
# WIN_FILE_SERVER_BIND=192.0.2.1    # address on REMOTE_HOST that the VM can reach (e.g. the libvirt bridge), used to copy files to the VM
# Test device: pass vid:pid to the scripts, or set PERIWIRE_TEST_DEVICE=vid:pid (always a SPARE device); some tools also take PERIWIRE_TEST_BUSID.
